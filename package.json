    "framer-motion": "12.43.0",
    "immer": "11.1.21",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "0.577.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "qrcode": "1.5.4",
